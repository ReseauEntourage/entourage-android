<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="16dp"
    android:layout_marginStart="@dimen/entourage_marginstart"
    android:layout_marginEnd="@dimen/entourage_margin_end">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/quicksand_bold"
        android:text="Votre parcours de bienvenue"
        android:textColor="@color/grey_dark"
        android:textSize="@dimen/entourage_font_large"
        app:layout_constraintEnd_toStartOf="@+id/btn_more"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btn_more"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/welcome_journey_options"
        android:fontFamily="@font/quicksand_bold"
        android:gravity="center"
        android:text="⋯"
        android:textColor="@color/grey_dark"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title" />

    <LinearLayout
        android:id="@+id/layout_progress_bars"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:importantForAccessibility="yes"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">

        <View
            android:id="@+id/progress_segment_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_welcome_progress_segment_off" />

        <View
            android:id="@+id/progress_segment_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_welcome_progress_segment_off" />

        <View
            android:id="@+id/progress_segment_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_welcome_progress_segment_off" />

        <View
            android:id="@+id/progress_segment_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_welcome_progress_segment_off" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_microcopy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/nunitosans_regular"
        android:text="Commençons 💛"
        android:textColor="@color/grey"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_progress_bars" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_step_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_welcome_step_active"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_microcopy">

        <ImageView
            android:id="@+id/iv_icon_step_1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_orange_lucide"
            android:padding="8dp"
            android:src="@drawable/ic_lucide_video"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title_step_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/quicksand_bold"
            android:text="1 min pour tout comprendre"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@+id/tv_badge_step_1"
            app:layout_constraintStart_toEndOf="@+id/iv_icon_step_1"
            app:layout_constraintTop_toTopOf="@+id/iv_icon_step_1" />

        <TextView
            android:id="@+id/tv_badge_step_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_todo"
            android:fontFamily="@font/nunitosans_bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="À faire"
            android:textColor="@color/orange"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title_step_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title_step_1" />

        <TextView
            android:id="@+id/tv_desc_step_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/nunitosans_regular"
            android:text="Qui sommes-nous, comment ça marche, et comment vous pouvez agir en 1 minute"
            android:textColor="@color/grey"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_title_step_1"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_step_1" />

        <TextView
            android:id="@+id/btn_redo_step_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:minHeight="40dp"
            android:text="@string/welcome_journey_redo_step"
            android:textColor="@color/orange_entourage"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/tv_title_step_1"
            app:layout_constraintTop_toBottomOf="@+id/tv_desc_step_1" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_step_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/quicksand_bold"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="@string/welcome_video_cta"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:backgroundTint="@color/orange"
            app:cornerRadius="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_desc_step_1" />

        <TextView
            android:id="@+id/btn_skip_step_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:minHeight="40dp"
            android:text="@string/welcome_journey_skip_step"
            android:textColor="@color/grey"
            android:textSize="13sp"
            android:visibility="gone"
            android:textStyle="normal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_step_1" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_step_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_welcome_step_future"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/card_step_1">

        <ImageView
            android:id="@+id/iv_icon_step_2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_orange_lucide"
            android:padding="8dp"
            android:src="@drawable/ic_group_welcome_home"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title_step_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/quicksand_bold"
            android:text="Rejoignez un groupe qui vous ressemble"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@+id/tv_badge_step_2"
            app:layout_constraintStart_toEndOf="@+id/iv_icon_step_2"
            app:layout_constraintTop_toTopOf="@+id/iv_icon_step_2" />

        <TextView
            android:id="@+id/tv_badge_step_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_future"
            android:fontFamily="@font/nunitosans_bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="À faire"
            android:textColor="@color/grey"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title_step_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title_step_2" />

        <TextView
            android:id="@+id/tv_desc_step_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/nunitosans_regular"
            android:text="Des membres partout en France partagent vos centres d'intérêt. Rejoignez-les."
            android:textColor="@color/grey"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_title_step_2"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_step_2" />

        <TextView
            android:id="@+id/btn_redo_step_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:minHeight="40dp"
            android:text="@string/welcome_journey_redo_step"
            android:textColor="@color/orange_entourage"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/tv_title_step_2"
            app:layout_constraintTop_toBottomOf="@+id/tv_desc_step_2" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_step_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/quicksand_bold"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="Voir les groupes"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:visibility="gone"
            app:backgroundTint="@color/orange"
            app:cornerRadius="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_desc_step_2" />

        <TextView
            android:id="@+id/btn_skip_step_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:minHeight="40dp"
            android:text="@string/welcome_journey_skip_step"
            android:textColor="@color/grey"
            android:textSize="13sp"
            android:visibility="gone"
            android:textStyle="normal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_step_2" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_step_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_welcome_step_future"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/card_step_2">

        <ImageView
            android:id="@+id/iv_icon_step_3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_orange_lucide"
            android:padding="8dp"
            android:src="@drawable/ic_lucide_users"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title_step_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/quicksand_bold"
            android:text="Rencontrez l'équipe en visio"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@+id/tv_badge_step_3"
            app:layout_constraintStart_toEndOf="@+id/iv_icon_step_3"
            app:layout_constraintTop_toTopOf="@+id/iv_icon_step_3" />

        <TextView
            android:id="@+id/tv_badge_step_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_future"
            android:fontFamily="@font/nunitosans_bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="À faire"
            android:textColor="@color/grey"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title_step_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title_step_3" />

        <TextView
            android:id="@+id/tv_desc_step_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/nunitosans_regular"
            android:text="Une session d'accueil en petit groupe pour poser vos questions à l'équipe avec plusieurs créneaux disponibles."
            android:textColor="@color/grey"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_title_step_3"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_step_3" />

        <TextView
            android:id="@+id/btn_redo_step_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:minHeight="40dp"
            android:text="@string/welcome_journey_redo_step"
            android:textColor="@color/orange_entourage"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/tv_title_step_3"
            app:layout_constraintTop_toBottomOf="@+id/tv_desc_step_3" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_step_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/quicksand_bold"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="Voir les prochaines dates"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:visibility="gone"
            app:backgroundTint="@color/orange"
            app:cornerRadius="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_desc_step_3" />

        <TextView
            android:id="@+id/btn_skip_step_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:minHeight="40dp"
            android:text="@string/welcome_journey_skip_step"
            android:textColor="@color/grey"
            android:textSize="13sp"
            android:visibility="gone"
            android:textStyle="normal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_step_3" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_step_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_welcome_step_future"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/card_step_3">

        <ImageView
            android:id="@+id/iv_icon_step_4"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_orange_lucide"
            android:padding="8dp"
            android:src="@drawable/ic_lucide_messages"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title_step_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/quicksand_bold"
            android:text="@string/welcome_step4_title"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@+id/tv_badge_step_4"
            app:layout_constraintStart_toEndOf="@+id/iv_icon_step_4"
            app:layout_constraintTop_toTopOf="@+id/iv_icon_step_4" />

        <TextView
            android:id="@+id/tv_badge_step_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_future"
            android:fontFamily="@font/nunitosans_bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="À faire"
            android:textColor="@color/grey"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title_step_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title_step_4" />

        <TextView
            android:id="@+id/tv_desc_step_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/nunitosans_regular"
            android:text="@string/welcome_step4_desc"
            android:textColor="@color/grey"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_title_step_4"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_step_4" />

        <TextView
            android:id="@+id/btn_redo_step_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:minHeight="40dp"
            android:text="@string/welcome_journey_redo_step"
            android:textColor="@color/orange_entourage"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/tv_title_step_4"
            app:layout_constraintTop_toBottomOf="@+id/tv_desc_step_4" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_step_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/quicksand_bold"
            android:textAlignment="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="@string/welcome_step4_cta"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:visibility="gone"
            app:backgroundTint="@color/orange"
            app:cornerRadius="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_desc_step_4" />

        <TextView
            android:id="@+id/btn_skip_step_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:minHeight="40dp"
            android:text="@string/welcome_journey_skip_step"
            android:textColor="@color/grey"
            android:textSize="13sp"
            android:visibility="gone"
            android:textStyle="normal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_step_4" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_success"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_welcome_success"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/tv_microcopy">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:text="@string/welcome_journey_complete"
            android:textColor="@color/green"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>