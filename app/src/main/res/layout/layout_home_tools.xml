<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/tv_home_tools_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_title_tools"
        android:fontFamily="@font/quicksand_bold"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:layout_marginBottom="12dp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_tools_map"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/home_v2_action_item_shape"
            android:padding="12dp"
            android:layout_marginEnd="8dp"
            android:minHeight="140dp">

            <ImageView
                android:id="@+id/iv_tools_map_bg"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_home_tool_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:padding="10dp"
                android:src="@drawable/ic_button_home_carte"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/home_tools_map"
                android:fontFamily="@font/quicksand_bold"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@+id/iv_tools_map_bg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="8dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_tools_pedago"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/home_v2_action_item_shape"
            android:layout_weight="1"
            android:padding="12dp"
            android:layout_marginEnd="8dp"
            android:minHeight="140dp">

            <ImageView
                android:id="@+id/iv_tools_pedago_bg"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_home_tool_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:padding="10dp"
                android:src="@drawable/ic_button_home_pedago"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/home_tools_pedago"
                android:fontFamily="@font/quicksand_bold"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@+id/iv_tools_pedago_bg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="8dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_tools_charter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/home_v2_action_item_shape"
            android:padding="12dp"
            android:minHeight="140dp">

            <ImageView
                android:id="@+id/iv_tools_charter_bg"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_home_tool_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:padding="10dp"
                android:src="@drawable/ic_button_home_charte"
                />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/home_tools_charter"
                android:fontFamily="@font/quicksand_bold"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@+id/iv_tools_charter_bg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="8dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_climate_map"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/shape_hz_item_home_v2"
            android:padding="16dp">

            <ImageView
                android:id="@+id/iv_climate_map_bg"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_climate_banner_icon"
                android:padding="12dp"
                android:src="@drawable/ic_ac_unit"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tv_climate_map_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:text="@string/home_climate_banner_title"
                android:fontFamily="@font/quicksand_bold"
                android:textSize="16sp"
                android:textColor="@color/white"
                app:layout_constraintStart_toEndOf="@id/iv_climate_map_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/iv_climate_map_bg" />

            <TextView
                android:id="@+id/tv_climate_map_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="4dp"
                android:text="@string/home_climate_banner_subtitle"
                android:fontFamily="@font/nunitosans_regular"
                android:textSize="13sp"
                android:textColor="@color/white"
                app:layout_constraintStart_toEndOf="@id/iv_climate_map_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_climate_map_title"
                app:layout_constraintBottom_toBottomOf="@id/iv_climate_map_bg" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_climate_map_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_climate_banner_badge"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/home_climate_banner_badge"
            android:textAllCaps="true"
            android:fontFamily="@font/quicksand_bold"
            android:textSize="11sp"
            android:textColor="@color/white" />

    </FrameLayout>

</LinearLayout>