<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="false">

    <!-- Squelette affiché tant que le profil n'est pas prêt (remplace l'ancien ProgressBar + écran blanc) -->
    <include
        android:id="@+id/profile_skeleton"
        layout="@layout/layout_profile_skeleton"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/container_profile">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/iv_fond_profile"
            android:src="@drawable/header"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/profile_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageView
                android:id="@+id/icon_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back_white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/profile_nested_scroll_view"
                />
            <ImageView
                android:id="@+id/icon_option"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:padding="10dp"
                android:src="@drawable/ic_option_profile"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/profile_nested_scroll_view"
                />
            <ImageView
                android:id="@+id/icon_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:src="@drawable/ic_settings_profile"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/profile_nested_scroll_view"
                />
            <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:id="@+id/iv_profile"
                app:layout_constraintTop_toTopOf="@+id/profile_nested_scroll_view"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="-55dp"
                android:background="@color/transparent"
                android:elevation="2dp"
                />
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:id="@+id/btn_modify_photo_profile"
                app:layout_constraintBottom_toBottomOf="@+id/iv_profile"
                app:layout_constraintEnd_toEndOf="@+id/iv_profile"
                android:background="@color/transparent"
                android:elevation="2dp"
                android:src="@drawable/ic_modify_photo_profile_full"
                android:layout_marginEnd="-15dp"
                />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:id="@+id/profile_nested_scroll_view"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="70dp"
                android:layout_marginHorizontal="@dimen/entourage_little_margin_five"
                android:paddingTop="@dimen/entourage_margin_top"
                android:paddingBottom="@dimen/entourage_margin_top"
                android:background="@drawable/home_scrollview_shape"
                android:fillViewport="true">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="50dp"
                        android:fontFamily="@font/quicksand_bold"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Name" />

                    <TextView
                        android:id="@+id/tv_member_since"
                        style="@style/left_courant_black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_name"
                        tools:text="Membre depuis 2 ans, mars 2024" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/tag_user"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginTop="@dimen/entourage_little_margin_top"
                        android:background="@drawable/home_v2_item_event_tag_layout_shape"
                        android:paddingHorizontal="15dp"
                        android:paddingVertical="6dp"

                        app:layout_constraintTop_toBottomOf="@+id/tv_member_since"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/tv_tag_home_v2_event_item"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:textColor="@color/orange"
                            android:fontFamily="@font/quicksand_bold"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            tools:text="Sport" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:id="@+id/iv_asso_badge"
                        app:layout_constraintTop_toTopOf="@+id/tag_user"
                        app:layout_constraintBottom_toBottomOf="@+id/tag_user"
                        app:layout_constraintStart_toEndOf="@+id/tag_user"
                        android:layout_marginStart="-10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tv_zone"
                        android:fontFamily="@font/nunitosans_regular"
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:textAlignment="center"
                        app:layout_constraintTop_toBottomOf="@+id/tag_user"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="10dp"
                        tools:text="Paris - Rayon de 20km "/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tv_phone"
                        android:fontFamily="@font/nunitosans_regular"
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:textAlignment="center"
                        app:layout_constraintTop_toBottomOf="@+id/tv_zone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="10dp"
                        tools:text="0601886036"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tv_mail"
                        android:fontFamily="@font/nunitosans_regular"
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:textAlignment="center"
                        app:layout_constraintTop_toBottomOf="@+id/tv_phone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="10dp"
                        tools:text="clement.perrousset@gmail.com"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/tv_description"
                        android:fontFamily="@font/nunitosans_regular"
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:textAlignment="center"
                        app:layout_constraintTop_toBottomOf="@+id/tv_mail"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="10dp"
                        android:layout_marginHorizontal="30dp"
                        tools:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nam pharetra nulla at metus condimentum, vitae viverra orci volutpat. Ut pretium tempus metus et laoreet. "/>

                    <Button
                        android:id="@+id/button_modify"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="47dp"
                        android:layout_weight="1"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/shape_button_v9_positive"
                        android:elevation="0dp"
                        android:fontFamily="@font/quicksand_bold"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="10dp"
                        android:text="@string/edit"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        app:layout_constraintTop_toBottomOf="@+id/tv_description"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/layout_achievement"
                        android:visibility="gone"
                        android:background="@drawable/rounded_bcknd_beige_profile_achievement"
                        app:layout_constraintTop_toBottomOf="@+id/button_modify"
                        app:layout_constraintStart_toStartOf="parent"
                        android:padding="10dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginTop="10dp"
                        app:layout_constraintEnd_toEndOf="parent">
                        <TextView
                            android:id="@+id/tv_impact_title"
                            style="@style/h2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="8dp"
                            android:textSize="18sp"
                            android:text="@string/impact_title_mine"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            />
                        <LinearLayout
                            android:id="@+id/layout_impact_filled"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_impact_title">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_impact_hero_card"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="18dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:baselineAligned="true"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_impact_hero"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/quicksand_bold"
                                        android:textColor="@color/orange"
                                        android:textSize="46sp"
                                        tools:text="87" />

                                    <TextView
                                        android:id="@+id/tv_impact_hero_label"
                                        style="@style/left_courant_bold_black"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:textSize="18sp"
                                        tools:text="fois engagé" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tv_impact_hero_subtitle"
                                    style="@style/left_courant_black"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    tools:text="au sein de la communauté" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_impact_section_title"
                                style="@style/left_courant_bold_black"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:layout_marginStart="4dp"
                                android:textAllCaps="true"
                                android:textColor="@color/grey"
                                android:textSize="12sp"
                                android:text="@string/impact_section_done" />

                            <LinearLayout
                                android:id="@+id/layout_impact_lines"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_impact_empty"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/layout_impact_filled">

                            <TextView
                                android:id="@+id/tv_impact_empty"
                                style="@style/left_courant_black"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/impact_empty_message" />

                            <Button
                                android:id="@+id/button_impact_discover"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/shape_button_v9_positive"
                                android:elevation="0dp"
                                android:fontFamily="@font/quicksand_bold"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="10dp"
                                android:text="@string/impact_empty_button"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                android:textSize="14sp" />
                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Badges section -->
                    <LinearLayout
                        android:id="@+id/section_badges"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/layout_achievement"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <!-- Title row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_badges_title"
                                style="@style/h2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="18sp"
                                android:text="@string/badges_section_title" />

                            <TextView
                                android:id="@+id/btn_voir_badges"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/badges_see_all"
                                android:textColor="@color/orange"
                                android:fontFamily="@font/nunitosans_semibold"
                                android:textSize="13sp"
                                android:paddingStart="8dp" />
                        </LinearLayout>

                        <!-- Horizontal scrollable badge cards -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/badges_row"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingBottom="4dp" />

                        </HorizontalScrollView>

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/rv_section_profile"
                        android:layout_marginHorizontal="5dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@+id/section_badges"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        />
                    <include
                        android:id="@+id/layout_ambassador_resources"
                        layout="@layout/layout_ambassador_resources"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/rv_section_profile"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/app_version"
                        style="@style/version_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="50dp"
                        android:textAlignment="center"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_ambassador_resources"
                        app:layout_constraintBottom_toTopOf="@id/app_debug_info"
                        tools:text="Entourage ©2026 v13.0" />

                    <TextView
                        android:id="@+id/app_debug_info"
                        style="@style/version_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:textAlignment="center"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/app_version"
                        app:layout_constraintBottom_toBottomOf="parent"
                        tools:text="fID: 8.1" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/container_fragment"
            android:background="@color/white"
            android:elevation="10dp"
            android:visibility="gone"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

