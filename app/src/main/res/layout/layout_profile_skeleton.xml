<?xml version="1.0" encoding="utf-8"?>
<!--
    Squelette de la page profil (mon profil et profil d'un autre membre), affiché à la place de l'écran
    tant que ses données ne sont pas arrivées. Même silhouette que activity_layout_profile.xml :
    bandeau orange, carte aux coins arrondis, avatar à cheval, nom, pastille, compteurs, sections.
    Les blocs gris sont animés par le même Shimmer que le squelette de l'accueil.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:elevation="30dp">

    <ImageView
        android:id="@+id/skeleton_header_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Reçoit la marge de la barre d'état (comme profile_content dans l'écran réel) pour éviter un saut -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/skeleton_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/skeleton_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/entourage_little_margin_five"
            android:layout_marginTop="70dp"
            android:background="@drawable/home_scrollview_shape"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_profile_skeleton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/entourage_little_margin_five"
            android:layout_marginTop="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shimmer_auto_start="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/entourage_marginstart">

                <!-- Avatar à cheval sur le haut de la carte : le conteneur démarre 55dp au-dessus de la carte (marginTop=15dp
                 au lieu de 70dp), sinon le shimmer rognerait la moitié haute de l'avatar -->
                <View
                    android:id="@+id/skeleton_avatar"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/shape_skeleton_avatar_circle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/skeleton_name"
                    android:layout_width="160dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="119dp"
                    android:background="@drawable/bg_skeleton_block"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/skeleton_member_since"
                    android:layout_width="110dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_skeleton_block"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/skeleton_name" />

                <View
                    android:id="@+id/skeleton_tag"
                    android:layout_width="120dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_skeleton_block"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/skeleton_member_since" />

                <!-- Description -->
                <View
                    android:id="@+id/skeleton_description_1"
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_skeleton_block"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/skeleton_tag" />

                <View
                    android:id="@+id/skeleton_description_2"
                    android:layout_width="220dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_skeleton_block"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/skeleton_description_1" />

                <!-- Compteurs d'impact -->
                <LinearLayout
                    android:id="@+id/skeleton_counters"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/skeleton_description_2">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_skeleton_block" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_skeleton_block" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_skeleton_block" />
                </LinearLayout>

                <!-- Lignes de sections -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/skeleton_counters">

                    <View
                        android:layout_width="140dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_skeleton_block" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_skeleton_block" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_skeleton_block" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_skeleton_block" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
