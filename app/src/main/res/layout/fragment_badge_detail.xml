<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="32dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_rounded_button_grey_stroke_slim" />

    <!-- Header back -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_baseline_arrow_back_24"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="center"
            android:text="@string/badges_screen_title"
            android:fontFamily="@font/nunitosans_bold"
            android:textSize="17sp"
            android:textColor="@color/black" />

        <View android:layout_width="24dp" android:layout_height="24dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- Emoji -->
            <ImageView
                android:id="@+id/iv_badge_icon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:contentDescription="@null" />

            <!-- Title -->
            <TextView
                android:id="@+id/tv_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAlignment="center"
                android:fontFamily="@font/quicksand_bold"
                android:textSize="24sp"
                android:textColor="@color/black"
                tools:text="Premier pas" />

            <!-- Status card — obtained -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/green_light"
                app:strokeWidth="0dp"
                app:strokeColor="@color/grey_light">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:gravity="center">

                    <LinearLayout
                        android:id="@+id/layout_obtained"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_check_green"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tv_obtained_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="6dp"
                            android:fontFamily="@font/nunitosans_bold"
                            android:textSize="15sp"
                            android:textColor="@color/green"
                            tools:text="Obtenu le 12 janvier 2026" />
                    </LinearLayout>

                    <!-- Not obtained / in-progress state -->
                    <LinearLayout
                        android:id="@+id/layout_not_obtained"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Row: "Votre progression" + "X/Y" -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/badge_progress_label"
                                android:fontFamily="@font/nunitosans_bold"
                                android:textSize="15sp"
                                android:textColor="@color/black" />

                            <TextView
                                android:id="@+id/tv_progress_detail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunitosans_bold"
                                android:textSize="15sp"
                                android:textColor="@color/orange"
                                tools:text="0 / 3" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progress_bar_detail"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="10dp"
                            android:progressDrawable="@drawable/badge_progress_bar"
                            tools:progress="0" />

                        <TextView
                            android:id="@+id/tv_progress_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/nunitosans_regular"
                            android:textSize="13sp"
                            android:textColor="@color/grey"
                            tools:text="Encore 3 événements à créer ou co-animer pour obtenir ce badge." />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- How it works -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/badge_how_it_works_title"
                android:fontFamily="@font/nunitosans_bold"
                android:textSize="11sp"
                android:textColor="@color/grey"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tv_how_it_works"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/nunitosans_regular"
                android:textSize="14sp"
                android:textColor="@color/black"
                tools:text="Terminez votre onboarding puis réalisez votre première action sur l'app." />

            <!-- Mechanism -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/badge_mechanism_title"
                android:fontFamily="@font/nunitosans_bold"
                android:textSize="11sp"
                android:textColor="@color/grey"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:id="@+id/iv_mechanism_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_close_black_24dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_mechanism"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:fontFamily="@font/nunitosans_regular"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    tools:text="Irréversible — une fois obtenu, c'est pour toujours." />
            </LinearLayout>

            <!-- What it means -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/badge_what_it_means_title"
                android:fontFamily="@font/nunitosans_bold"
                android:textSize="11sp"
                android:textColor="@color/grey"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tv_what_it_means"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/nunitosans_regular"
                android:textSize="14sp"
                android:textColor="@color/black"
                tools:text="Ce badge célèbre votre arrivée dans la communauté." />

            <!-- CTA Button -->
            <Button
                android:id="@+id/btn_cta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_accent_rounded_large_radius"
                android:textColor="@color/white"
                android:fontFamily="@font/nunitosans_bold"
                android:textSize="15sp"
                android:paddingVertical="14dp"
                android:textAllCaps="false"
                tools:text="Faire une première action" />

            <!-- Link -->
            <TextView
                android:id="@+id/tv_see_all_badges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAlignment="center"
                android:text="@string/badge_see_all_mine"
                android:textColor="@color/orange"
                android:fontFamily="@font/nunitosans_semibold"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
