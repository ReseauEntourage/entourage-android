<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contenu scrollable -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/root_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Titre -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="22dp"
                android:text="@string/onboard_asso_title"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:fontFamily="@font/quicksand_bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Sous-titre -->
            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="22dp"
                android:text="@string/onboard_asso_subtitle"
                android:textSize="14sp"
                android:textColor="@color/pre_onboard_black"
                android:fontFamily="@font/nunitosans_regular"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Dropdown association -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/dropdown_assoc"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="22dp"
                android:hint="@string/onboard_asso_dropdown_hint"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/pre_onboard_black"
                app:endIconMode="dropdown_menu"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <AutoCompleteTextView
                    android:id="@+id/actv_assoc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:fontFamily="@font/nunitosans_regular"
                    android:textColor="@color/black"
                    android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Bulle orange contenant le champ "Autre" -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/info_panel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="22dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFF3E5"
                app:strokeColor="#FFC68A"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/dropdown_assoc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info_24"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/onboard_asso_info"
                            android:textColor="#6B3B00"
                            android:textSize="13sp"
                            android:fontFamily="@font/nunitosans_regular"
                            android:layout_marginBottom="8dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/input_other_assoc"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/onboard_asso_other_label"
                            app:boxBackgroundMode="outline">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_other_assoc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/onboard_asso_other_placeholder"
                                android:maxLines="1"
                                android:background="@color/white"
                                android:fontFamily="@font/nunitosans_regular"
                                android:textColor="@color/black"
                                android:textSize="15sp"/>
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Espace de fin pour ne pas coller la bottom bar -->
            <Space
                android:layout_width="0dp"
                android:layout_height="36dp"
                app:layout_constraintTop_toBottomOf="@id/info_panel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom bar fixée -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/button_previous"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="47dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/shape_button_v9_negative"
            android:elevation="0dp"
            android:fontFamily="@font/quicksand_bold"
            android:paddingVertical="10dp"
            android:text="@string/previous"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/button_next"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="47dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/shape_button_v9_positive"
            android:elevation="0dp"
            android:fontFamily="@font/quicksand_bold"
            android:paddingVertical="10dp"
            android:text="@string/onboarding_btn_next"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
