<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout"
    android:layout_width="@dimen/home_action_card_width"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/entourage_marginstart"
    android:layout_marginEnd="@dimen/entourage_little_margin_end"
    android:layout_marginTop="@dimen/entourage_little_margin_top"
    android:background="@drawable/home_v2_action_item_shape"
    android:padding="16dp">

    <!-- Avatar -->
    <ImageView
        android:id="@+id/iv_action_item"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:background="@drawable/home_user_avatar_border"
        android:padding="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/placeholder_user" />

    <!-- Name -->
    <TextView
        android:id="@+id/tv_action_item_author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/entourage_little_margin_start"
        android:fontFamily="@font/quicksand_bold"
        android:textColor="@color/black"
        android:textSize="@dimen/entourage_font_medium"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_action_item"
        app:layout_constraintTop_toTopOf="@+id/iv_action_item"
        tools:text="Prénom" />

    <!-- Category Tag -->
    <TextView
        android:id="@+id/tv_action_item_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/entourage_little_margin_start"
        android:layout_marginTop="4dp"
        android:background="@drawable/home_action_category_bg"
        android:fontFamily="@font/nunitosans_regular"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/orange"
        android:textSize="@dimen/entourage_font_very_small"
        app:layout_constraintStart_toEndOf="@+id/iv_action_item"
        app:layout_constraintTop_toBottomOf="@+id/tv_action_item_author"
        tools:text="Catégorie" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_action_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:fontFamily="@font/quicksand_bold"
        android:maxLines="2"
        android:textColor="@color/black"
        android:textSize="@dimen/entourage_font_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_action_item"
        tools:text="Titre de la demande concis et percutant" />

    <!-- Description -->
    <TextView
        android:id="@+id/tv_action_item_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/nunitosans_regular"
        android:maxLines="3"
        android:textColor="@color/grey_dark"
        android:textSize="@dimen/entourage_font_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_action_item_title"
        tools:text="Description courte commençant par une majuscule et se terminant par des points de suspension..." />

    <!-- Location Pin Icon -->
    <ImageView
        android:id="@+id/iv_action_item_dist_icon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_location_gds_detail"
        app:tint="@color/orange"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_action_item_description" />

    <!-- Distance Text -->
    <TextView
        android:id="@+id/tv_action_item_distance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/nunitosans_regular"
        android:textColor="@color/orange"
        android:textSize="@dimen/entourage_font_very_small"
        app:layout_constraintBottom_toBottomOf="@+id/iv_action_item_dist_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_action_item_dist_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_action_item_dist_icon"
        tools:text="0.5km de moi" />

</androidx.constraintlayout.widget.ConstraintLayout>