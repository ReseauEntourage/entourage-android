<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/new_rounded_button"
    android:paddingHorizontal="24dp"
    android:paddingTop="26dp"
    android:paddingBottom="22dp">

    <ImageButton
        android:id="@+id/btn_cross"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:background="@color/transparent"
        android:src="@drawable/iconcross"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_limited_places"
        android:fontFamily="@font/nunitosans_bold"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/orange_entourage"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="⏳ Places limitées" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/quicksand_bold"
        android:textColor="@android:color/black"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/badge"
        tools:text="Réservez votre place !" />

    <TextView
        android:id="@+id/intro"
        style="@style/h4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"
        tools:text="Le nombre de places étant limité pour cet événement, votre inscription se fait sur demande :" />

    <LinearLayout
        android:id="@+id/steps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_rounded_button_grey_stroke_slim"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/intro">

        <LinearLayout
            android:id="@+id/step1_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/step1_num"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_circle_solid_orange"
                android:fontFamily="@font/quicksand_bold"
                android:gravity="center"
                android:text="1"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/step1_text"
                style="@style/h4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                tools:text="Vous rejoignez la discussion et demandez votre place." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/step2_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/step2_num"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_circle_solid_orange"
                android:fontFamily="@font/quicksand_bold"
                android:gravity="center"
                android:text="2"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/step2_text"
                style="@style/h4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                tools:text="L'organisateur confirme votre inscription." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/step3_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/step3_num"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_circle_solid_orange"
                android:fontFamily="@font/quicksand_bold"
                android:gravity="center"
                android:text="3"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/step3_text"
                style="@style/h4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                tools:text="Vous êtes prévenu(e) par notification, SMS ou appel dès que c'est validé." />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/nudge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/nunitosans_regular"
        android:textColor="@color/grey"
        android:textSize="12.5sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/steps"
        tools:text="Un empêchement ? Pensez à vous désinscrire pour laisser votre place à quelqu'un d'autre." />

    <Button
        android:id="@+id/yes"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/new_bg_rounded_button_orange_fill"
        app:backgroundTint="@null"
        android:fontFamily="@font/quicksand_bold"
        android:gravity="center"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nudge"
        tools:text="Demander ma place" />

    <TextView
        android:id="@+id/no"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/nunitosans_regular"
        android:gravity="center"
        android:padding="4dp"
        android:textColor="@color/grey"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/yes"
        tools:text="Je ne souhaite pas m'inscrire" />

</androidx.constraintlayout.widget.ConstraintLayout>
