<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="15dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/background_organizer"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/iv_home_small_talk_avatar_1"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/placeholder_user"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_beige_round"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/iv_home_small_talk_avatar_2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="-10dp"
        android:src="@drawable/placeholder_user"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_beige_round"
        app:layout_constraintTop_toTopOf="@id/iv_home_small_talk_avatar_1"
        app:layout_constraintBottom_toBottomOf="@id/iv_home_small_talk_avatar_1"
        app:layout_constraintStart_toEndOf="@id/iv_home_small_talk_avatar_1" />

    <TextView
        android:id="@+id/tv_home_small_talk_title_active"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/home_title_small_talk_active"
        android:fontFamily="@font/quicksand_bold"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="16dp"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_home_small_talk_avatar_2"
        app:layout_constraintEnd_toStartOf="@+id/button_voir" />

    <TextView
        android:id="@+id/tv_home_small_talk_subtitle_active"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="3 discussions actives"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/nunitosans_regular"
        android:textSize="13sp"
        android:textColor="@color/grey_dark"
        app:layout_constraintTop_toBottomOf="@+id/tv_home_small_talk_title_active"
        app:layout_constraintStart_toEndOf="@+id/iv_home_small_talk_avatar_2"
        app:layout_constraintEnd_toStartOf="@+id/button_voir" />

    <TextView
        android:id="@+id/tv_home_small_talk_matching"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="+1 en cours de matching"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/nunitosans_regular"
        android:textSize="13sp"
        android:textColor="@color/orange"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/tv_home_small_talk_subtitle_active"
        app:layout_constraintStart_toEndOf="@+id/iv_home_small_talk_avatar_2"
        app:layout_constraintEnd_toStartOf="@+id/button_voir" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_voir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/orange"
        app:cornerRadius="32dp"
        android:fontFamily="@font/quicksand_bold"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        android:text="Voir"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_news_group"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/tomato"
        android:layout_marginEnd="-4dp"
        android:layout_marginTop="-4dp"
        app:layout_constraintTop_toTopOf="@+id/button_voir"
        app:layout_constraintEnd_toEndOf="@+id/button_voir">

        <TextView
            android:id="@+id/tv_news_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:fontFamily="@font/quicksand_bold"
            android:layout_gravity="center"
            android:gravity="center" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_home_small_talk_launch_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ Lancer une nouvelle rencontre"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/nunitosans_regular"
        android:textSize="14sp"
        android:textColor="@color/orange"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_home_small_talk_matching"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>