<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/presentation_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_beige"
    android:orientation="vertical">

    <!-- Barre du haut : fermeture + progression -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp">

        <ImageView
            android:id="@+id/presentation_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/group_presentation_close"
            android:padding="8dp"
            android:src="@drawable/ic_close_black_24dp" />

        <TextView
            android:id="@+id/presentation_progress"
            style="@style/left_courant_bold_orange"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="28dp"
            android:paddingTop="16dp">

            <!-- Étape 1 : ce qu'on aime -->
            <LinearLayout
                android:id="@+id/step_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/step_profile_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand_bold"
                    android:textColor="@color/orange"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/step_profile_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/nunitosans_regular"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/interests_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:flexWrap="wrap" />

                <TextView
                    android:id="@+id/complete_profile"
                    style="@style/left_courant_bold_orange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:padding="4dp"
                    android:text="@string/group_presentation_complete_profile"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Étape 2 : pourquoi on est là -->
            <LinearLayout
                android:id="@+id/step_intents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand_bold"
                    android:text="@string/group_presentation_intents_title"
                    android:textColor="@color/orange"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/nunitosans_regular"
                    android:text="@string/group_presentation_intents_subtitle"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/intents_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical" />

                <EditText
                    android:id="@+id/about_input"
                    style="@style/input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/light_orange_opacity_50"
                    android:hint="@string/group_presentation_about_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="3" />
            </LinearLayout>

            <!-- Étape 3 : aperçu modifiable -->
            <LinearLayout
                android:id="@+id/step_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand_bold"
                    android:text="@string/group_presentation_preview_title"
                    android:textColor="@color/orange"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/nunitosans_regular"
                    android:text="@string/group_presentation_preview_subtitle"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/preview_message"
                    style="@style/input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_chip_conversation_suggestion"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="8"
                    android:padding="16dp" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <Button
        android:id="@+id/presentation_next"
        style="@style/h2_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginVertical="16dp"
        android:background="@drawable/bg_button_orange_fill"
        android:textAllCaps="false" />
</LinearLayout>
