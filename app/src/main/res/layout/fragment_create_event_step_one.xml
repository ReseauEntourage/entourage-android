<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="6dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/create_event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_event_step_one_title" />

        <!-- Nom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/create_event_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/event_name" />

            <TextView
                style="@style/create_event_required"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_event_required" />
        </LinearLayout>

        <EditText
            android:id="@+id/event_name"
            style="@style/create_event_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/create_event_name_placeholder"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3" />

        <TextView
            android:id="@+id/event_name_error"
            style="@style/create_event_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Description -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/create_event_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_event_description_label" />

            <TextView
                style="@style/create_event_required"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_event_required" />
        </LinearLayout>

        <TextView
            style="@style/create_event_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:text="@string/create_event_description_hint" />

        <EditText
            android:id="@+id/event_description"
            style="@style/create_event_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/create_event_description_placeholder"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="900"
            android:minHeight="112dp" />

        <TextView
            android:id="@+id/counter"
            style="@style/create_event_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:textSize="11sp"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/event_description_error"
            style="@style/create_event_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Photo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/create_event_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/picture" />

            <TextView
                style="@style/create_event_required"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_event_required" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/add_photo_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_create_event_photo_empty"
            android:gravity="center"
            android:minHeight="120dp"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_create_event_icon_tile"
                android:importantForAccessibility="no"
                android:padding="11dp"
                android:src="@drawable/ic_create_event_image" />

            <TextView
                android:id="@+id/add_photo_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="@font/nunitosans_bold"
                android:text="@string/create_event_photo_add"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                style="@style/create_event_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/create_event_photo_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Photo choisie (catalogue, galerie ou événement édité) -->
        <ImageView
            android:id="@+id/add_photo"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:contentDescription="@string/picture"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/photo_error"
            style="@style/create_event_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
