<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="6dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/create_event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_event_step_two_title" />

        <!-- Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/create_event_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/date" />

            <TextView
                style="@style/create_event_required"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_event_required" />
        </LinearLayout>

        <TextView
            android:id="@+id/event_date"
            style="@style/create_event_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/ic_event_date"
            android:focusable="true"
            android:gravity="center_vertical"
            android:hint="@string/date_hint" />

        <TextView
            android:id="@+id/event_date_error"
            style="@style/create_event_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Heures -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/create_event_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/start_time" />

                <TextView
                    android:id="@+id/start_time"
                    style="@style/create_event_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_event_time"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:hint="@string/time_hint" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/create_event_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/end_time" />

                <TextView
                    android:id="@+id/end_time"
                    style="@style/create_event_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_event_time"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:hint="@string/time_hint" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/event_time_error"
            style="@style/create_event_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Récurrence (réservée aux utilisateurs autorisés) -->
        <TextView
            android:id="@+id/recurrence_title"
            style="@style/create_event_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/recurrence" />

        <RadioGroup
            android:id="@+id/recurrence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/once"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/black"
                android:fontFamily="@font/nunitosans_regular"
                android:minHeight="48dp"
                android:paddingStart="10dp"
                android:text="@string/juste_once"
                android:textColor="@color/black"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/every_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/black"
                android:fontFamily="@font/nunitosans_regular"
                android:minHeight="48dp"
                android:paddingStart="10dp"
                android:text="@string/every_week"
                android:textColor="@color/black"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/every_two_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/black"
                android:fontFamily="@font/nunitosans_regular"
                android:minHeight="48dp"
                android:paddingStart="10dp"
                android:text="@string/every_two_week"
                android:textColor="@color/black"
                android:textSize="15sp" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
